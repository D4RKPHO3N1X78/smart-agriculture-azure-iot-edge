{
  "$schema-version": "1.0.0",
  "modulesContent": {
    "$edgeAgent": {
      "properties.desired": {
        "schemaVersion": "1.1",
        "runtime": {
          "type": "docker",
          "settings": {
            "minDockerVersion": "v1.25",
            "loggingOptions": "",
            "registryCredentials": {
              "containerRegistry": {
                "username": "$CONTAINER_REGISTRY_USERNAME",
                "password": "$CONTAINER_REGISTRY_PASSWORD",
                "address": "$CONTAINER_REGISTRY_SERVER"
              }
            }
          }
        },
        "systemModules": {
          "edgeAgent": {
            "type": "docker",
            "settings": {
              "image": "mcr.microsoft.com/azureiotedge-agent:1.4",
              "createOptions": {}
            }
          },
          "edgeHub": {
            "type": "docker",
            "status": "running",
            "restartPolicy": "always",
            "settings": {
              "image": "mcr.microsoft.com/azureiotedge-hub:1.4",
              "createOptions": {
                "HostConfig": {
                  "PortBindings": {
                    "5671/tcp": [{"HostPort": "5671"}],
                    "8883/tcp": [{"HostPort": "8883"}],
                    "443/tcp": [{"HostPort": "443"}]
                  }
                }
              }
            }
          }
        },
        "modules": {
          "irrigationDecisionModule": {
            "version": "1.0",
            "type": "docker",
            "status": "running",
            "restartPolicy": "always",
            "settings": {
              "image": "$CONTAINER_REGISTRY_SERVER/smart-irrigation-module:1.0.0",
              "createOptions": {
                "HostConfig": {
                  "Memory": 268435456,
                  "NanoCpus": 500000000
                }
              }
            },
            "env": {
              "PYTHONUNBUFFERED": {
                "value": "1"
              }
            }
          }
        }
      }
    },
    "$edgeHub": {
      "properties.desired": {
        "schemaVersion": "1.2",
        "routes": {
          "sensorToIrrigation": "FROM /messages/modules/sensorSimulatorModule/outputs/* INTO BrokeredEndpoint(\"/modules/irrigationDecisionModule/inputs/sensorInput\")",
          "irrigationAlertsToUpstream": "FROM /messages/modules/irrigationDecisionModule/outputs/irrigationAlerts INTO $upstream"
        },
        "storeAndForwardConfiguration": {
          "timeToLiveSecs": 604800
        }
      }
    },
    "irrigationDecisionModule": {
      "properties.desired": {
        "mode": "autonomous",
        "moisture_bias_offset": 0.0,
        "min_confidence_threshold": 0.60,
        "telemetry_interval_sec": 5
      }
    }
  }
}
